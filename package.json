{
  "name": "Limacina-front",
  "private": true,
  "version": "1.2.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dupcheck": "jscpd src src-tauri/src",
    "tauri": "tauri",
    "fonts": "bun run scripts/subset-fonts.ts",
    "build:installer-fonts": "bun run scripts/build-installer-fonts.ts",
    "build:dist": "bun scripts/build-dist.cjs",
    "clean": "cargo clean",
    "clean:cache": "rm -rf ~/.local/share/com.tekina.limacina/WebKitCache ~/.local/share/com.tekina.limacina/CacheStorage"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.47",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-notification": "2.5.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "animejs": "3",
    "dompurify": "3.4.16",
    "jszip": "^3.10.2",
    "marked": "18.0.12",
    "pinia": "^2.3.1",
    "three": "^0.185.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/animejs": "^3.1.13",
    "@types/node": "^26.6.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jscpd": "5.2.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "prettier": "^2.8.8",
    "sass": "^1.105.2",
    "subset-font": "2.6.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.12"
  }
}
