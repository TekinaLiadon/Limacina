{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "vue", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eslint/no-control-regex": "off",
    "eslint/no-underscore-dangle": ["error", { "allow": ["__TAURI_INTERNALS__"] }],
    "typescript/consistent-type-imports": ["warn", { "prefer": "type-imports", "fixStyle": "inline-type-imports" }],
    "typescript/array-type": "warn",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "eslint/prefer-destructuring": "warn",
    "eslint/no-duplicate-imports": "warn",
    "eslint/prefer-template": "warn",
    "eslint/no-promise-executor-return": "warn",
    "unicorn/prefer-string-replace-all": "warn",
    "unicorn/no-array-callback-reference": "warn",
    "unicorn/no-useless-undefined": "warn",
    "unicorn/catch-error-name": "warn",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "eslint/max-statements": ["error", { "max": 50 }],
    "eslint/complexity": ["error", { "max": 26 }],
    "eslint/max-depth": ["error", { "max": 4 }],
    "eslint/max-params": ["error", { "max": 4 }]
  },
  "overrides": [
    {
      "files": ["**/__tests__/**", "src/test-support/**", "scripts/**"],
      "rules": {
        "eslint/max-statements": "off",
        "eslint/complexity": "off",
        "eslint/max-depth": "off",
        "eslint/max-params": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-floating-promises": "off",
        "typescript/await-thenable": "off",
        "typescript/unbound-method": "off",
        "typescript/consistent-type-imports": ["warn", { "prefer": "type-imports", "fixStyle": "inline-type-imports", "disallowTypeAnnotations": false }]
      }
    },
    {
      "files": [
        "src/04-features/cpm-convert/cpmProjectExporter.ts",
        "src/04-features/cpm-convert/cpmAnimationWriter.ts",
        "src/04-features/game-launch/useGameLaunch.ts",
        "src/04-features/cpm-viewer/cpmModelBuilder.ts"
      ],
      "rules": {
        "eslint/max-statements": "off",
        "eslint/max-depth": "off"
      }
    },
    {
      "files": [
        "src/04-features/cpm-convert/cpmProjectExporter.ts",
        "src/04-features/cpm-convert/cpmAnimationWriter.ts",
        "src/04-features/cpm-settings/cpmAnimationParser.ts",
        "src/04-features/cpm-viewer/cpmModelBuilder.ts",
        "src/04-features/cpm-viewer/cpmAnimationPlayer.ts"
      ],
      "rules": {
        "eslint/complexity": "off"
      }
    },
    {
      "files": [
        "src/04-features/cpm-viewer/cpmModelBuilder.ts",
        "src/04-features/cpm-viewer/useCpmViewer.ts",
        "src/04-features/cpm-settings/useCpmSettings.ts",
        "src/04-features/skin-viewer/useSkinViewer.ts",
        "src/04-features/cpm-convert/bbmodelAnimations.ts",
        "src/06-shared/utils/numberStep.ts"
      ],
      "rules": {
        "eslint/max-params": "off"
      }
    },
    {
      "files": [
        "src/04-features/launcher-settings/useLauncherSettings.ts",
        "src/06-shared/utils/useDirtySnapshot.ts",
        "src/06-shared/utils/utils.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-parameters": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "public/", "src-tauri/", "legacy/"]
}
