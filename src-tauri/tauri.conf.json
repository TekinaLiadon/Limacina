{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limacina",
  "version": "0.4.0",
  "identifier": "com.tekina.limacina",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Limacina",
        "width": 960,
        "height": 640,
        "minWidth": 520,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#05060f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: https://cdn.modrinth.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "publisher": "Tekina",
    "copyright": "© 2026 Tekina",
    "shortDescription": "Лаунчер Minecraft: установка игры, модов и Java в один клик",
    "longDescription": "Limacina — Minecraft-лаунчер: устанавливает игру и Java, поддерживает Vanilla, Fabric, Forge и NeoForge, синхронизирует файлы и моды с сервером, управляет скинами и моделями игроков и обновляется автоматически.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "compression": "lzma"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "cpmproject"
        ],
        "name": "CPM Project",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "quiet"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzREREQjUxRUUwNDc0ODEKUldTQmRBVHVVZHZkNHdMcFRUZlpWKzh2VzU5WS9LSFh4YTlERUU3WVRJanQvWHBkRmpGOGwvSFgK"
    }
  }
}
