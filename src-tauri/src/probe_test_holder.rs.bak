#[tokio::test]
async fn probe_mockito_match() {
    use crate::modrinth::client::{modrinth_client, override_api_base_for_tests};
    use mockito::Server;

    let mut server = Server::new_async().await;
    override_api_base_for_tests(format!("{}/v2", server.url()));

    let mock = server
        .mock("GET", "/v2/project/AANobbMI")
        .with_status(200)
        .with_body("{}")
        .create_async()
        .await;

    let response = modrinth_client()
        .get(&format!("{}/v2/project/AANobbMI", crate::modrinth::client::api_base()))
        .send()
        .await
        .unwrap();
    println!("PROBE STATUS: {}", response.status());
    mock.assert_async().await;
}
